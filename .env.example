# ============================================================================
# Strata Environment Configuration
# ============================================================================
# Copy this file to .env and adjust values for your environment.
# All values shown are the defaults.
# ============================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=false
SERVER_WORKERS=1
SERVER_LOG_LEVEL=info
SERVER_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
DEBUG=false

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
STORAGE_BASE_PATH=./data/storage
STORAGE_MAX_UPLOAD_SIZE_MB=10240
STORAGE_TEMP_DIR=/tmp/strata

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_URL=sqlite+aiosqlite:///./data/strata.db
DB_ECHO=false

# ---------------------------------------------------------------------------
# Processing Pipeline
# ---------------------------------------------------------------------------
PROCESSING_MAX_FRAMES=500
PROCESSING_TARGET_FPS=2.0
PROCESSING_MIN_FRAME_SCORE=0.3
PROCESSING_BLUR_THRESHOLD=100.0
PROCESSING_MOTION_THRESHOLD=0.4
PROCESSING_FRAME_OVERLAP_THRESHOLD=0.85
PROCESSING_DEDUP_HASH_THRESHOLD=8
PROCESSING_MAX_UPLOAD_SIZE_MB=10240

# ---------------------------------------------------------------------------
# AI Models
# ---------------------------------------------------------------------------
AI_DEVICE=cuda
AI_DEPTH_MODEL_NAME=depth-anything-v2-base
AI_YOLO_MODEL=yolo11x.pt
AI_SAM2_MODEL=sam2_hiera_large.pt
AI_WEIGHTS_DIR=./models/weights
AI_MAX_BATCH_SIZE=8
AI_INFERENCE_PRECISION=fp16

# ---------------------------------------------------------------------------
# COLMAP
# ---------------------------------------------------------------------------
COLMAP_BINARY_PATH=colmap
COLMAP_MAX_FEATURES=8192
COLMAP_DENSE_POINT_COUNT=1000000
COLMAP_MATCHER_TYPE=sequential
COLMAP_CAMERA_MODEL=PINHOLE
COLMAP_BA_MAX_NUM_ITERATIONS=30
COLMAP_BA_MAX_NUM_IMAGES=300

# ---------------------------------------------------------------------------
# Dense Reconstruction
# ---------------------------------------------------------------------------
DENSE_VOXEL_SIZE=0.05
DENSE_MIN_DEPTH_M=0.2
DENSE_MAX_DEPTH_M=200.0
DENSE_PIXEL_NOISE_PX=0.5
DENSE_MAX_POINTS_PER_VIEW=1000000
DENSE_MAX_FUSION_POINTS=8000000
DENSE_SOR_K=20
DENSE_SOR_STD_RATIO=2.0
DENSE_ROR_RADIUS_M=0.4
DENSE_ROR_MIN_NEIGHBORS=5
DENSE_NORMAL_K=20
DENSE_MIN_CONFIDENCE=0.05

# Per-view depth generation + refinement
DENSE_DEPTH_BACKEND=auto
DENSE_STEREO_MIN_DISPARITY=0
DENSE_STEREO_NUM_DISPARITIES=96
DENSE_STEREO_BLOCK_SIZE=5
DENSE_STEREO_UNIQUENESS_RATIO=10
DENSE_STEREO_MAX_VIEWS=200
DENSE_REFINE_MEDIAN=false
DENSE_REFINE_MEDIAN_K=5
DENSE_REFINE_BILATERAL=false
DENSE_REFINE_EDGE_PRESERVING=false
DENSE_REFINE_HOLE_FILL=false

# ---------------------------------------------------------------------------
# Autonomous Pipeline
# ---------------------------------------------------------------------------
PIPE_STAGE_RETRIES=1
PIPE_DEFAULT_EXTRACTION_MODE=every_n
PIPE_DEFAULT_EVERY_N=10
PIPE_DEFAULT_TARGET_FPS=2.0

# ---------------------------------------------------------------------------
# Mesh Generation / Texturing / LOD (Phase 7)
# ---------------------------------------------------------------------------
MESH_METHOD=auto
MESH_SURFACE_MAX_EDGE_FACTOR=4.0
MESH_SURFACE_MIN_POINTS=50
MESH_ALPHA_MULTIPLIER=1.5
MESH_DECIMATE_PRESET=high
MESH_LOD_RATIOS=[1.0,0.5,0.25,0.12,0.06]
MESH_REPAIR_MIN_COMPONENT_FACES=12
MESH_REPAIR_MAX_HOLE_EDGES=64
MESH_WELD_PRECISION=1e-7
MESH_ATLAS_WIDTH=8192
MESH_TEXTURE_MAX_CAMERA_DIST=500.0

# ---------------------------------------------------------------------------
# Semantic Understanding / Object Detection (Phase 7)
# ---------------------------------------------------------------------------
SEMANTIC_BACKEND=auto
SEMANTIC_MODEL_PATH=./models/weights/semantic.onnx
SEMANTIC_DETECTION_BACKEND=auto
SEMANTIC_GROUND_PLANE_TOL_M=0.15
SEMANTIC_MIN_FACE_CONFIDENCE=0.25

# ---------------------------------------------------------------------------
# Geospatial Intelligence (Phase 8)
# ---------------------------------------------------------------------------
# Environmental analysis thresholds
INTEL_ENV_SAMPLE_FRAMES=24
INTEL_LOWLIGHT_LUMA_THRESHOLD=60.0
INTEL_BLUR_MIN_FOCUS=90.0
INTEL_FOG_DARK_CHANNEL_MAX=0.65
INTEL_VISIBILITY_MAX_M=15000.0
INTEL_SHADOW_LOW_PCT=0.15
INTEL_GLARE_HIGH_PCT=0.05

# Open-vocabulary scene understanding (classical fallback; dino/sam2 onnx optional)
INTEL_OPEN_VOCAB_BACKEND=auto
INTEL_DINO_MODEL_PATH=./models/weights/grounding_dino.onnx
INTEL_SAM2_MODEL_PATH=./models/weights/sam2.onnx
INTEL_MIN_CONCEPT_CONFIDENCE=0.3

# Damage assessment
INTEL_DAMAGE_MIN_AREA_M2=4.0
INTEL_COLLAPSE_MIN_FRAGMENT_FACES=40
INTEL_FLOOD_MIN_AREA_M2=8.0
INTEL_DEBRIS_MAX_HEIGHT_M=3.0

# Risk engine
INTEL_RISK_SLOPE_DEG=25.0
INTEL_RISK_GRID_CELLS=96
INTEL_FLOOD_BUFFER_M=25.0
INTEL_DEBRIS_BUFFER_M=15.0
INTEL_ACCESS_SLOPE_DEG=15.0

# Infrastructure
INTEL_MIN_ROAD_WIDTH_CLOUD_M=1.5
INTEL_TREE_MIN_HEIGHT_M=1.0

# RAG copilot (lexical local index always available; transformers optional)
INTEL_RAG_BACKEND=auto
INTEL_RAG_MODEL_NAME=all-MiniLM-L6-v2
INTEL_RAG_TOP_K=5
INTEL_RAG_CHUNK_WORDS=96

# Reporting
INTEL_REPORT_FORMATS=["json","md","html"]
INTEL_ORG_NAME=Strata
INTEL_MISSION_OPERATOR=mission_control

# ---------------------------------------------------------------------------
# Mission Planning (Phase 9)
# ---------------------------------------------------------------------------
PLAN_CAMERA_WIDTH_PX=5472
PLAN_CAMERA_HEIGHT_PX=3648
PLAN_SENSOR_WIDTH_MM=13.2
PLAN_SENSOR_HEIGHT_MM=8.8
PLAN_FOCAL_MM=8.8
PLAN_DRONE_MASS_KG=2.0
PLAN_BATTERY_CAPACITY_WH=60.0
PLAN_BATTERY_RESERVE_PCT=20.0
PLAN_HOVER_POWER_W_PER_KG=70.0
PLAN_DRAG_COEFF=0.06
PLAN_AVIONICS_W=12.0
PLAN_DEFAULT_ALTITUDE_M=60.0
PLAN_DEFAULT_SPEED_M_S=8.0
PLAN_DEFAULT_FORWARD_OVERLAP=0.7
PLAN_DEFAULT_SIDE_OVERLAP=0.6
PLAN_OPTIMIZE_ALTS_M=[40.0,50.0,60.0,80.0]
PLAN_OPTIMIZE_SPEEDS_M_S=[5.0,8.0,12.0]
PLAN_OPTIMIZE_OVERLAPS=[0.7,0.8]
PLAN_COVERAGE_GRID_CELLS=48
PLAN_BLIND_CONF_THRESHOLD=0.4
PLAN_OBSTACLE_CLEARANCE_M=15.0
PLAN_MIN_HISTORY_FOR_ML=5
PLAN_MIN_HISTORY_FOR_SIMILAR=1
PLAN_SIMILAR_TOP_K=3
PLAN_QUALITY_REF_ALTITUDE_M=40.0

# ---------------------------------------------------------------------------
# Enterprise Platform (Phase 10)
# ---------------------------------------------------------------------------
# auth_mode: disabled (legacy endpoints open — backward compatibility) or
#            required (every /api route except the public allowlist needs a
#            bearer token; production recommendation)
PLATFORM_AUTH_MODE=disabled
PLATFORM_SESSION_TTL_HOURS=12
PLATFORM_TOKEN_BYTES=32
# Bootstrap admin created at startup when both are set (idempotent)
PLATFORM_BOOTSTRAP_ADMIN_EMAIL=
PLATFORM_BOOTSTRAP_ADMIN_PASSWORD=
# Queue worker
PLATFORM_QUEUE_MAX_WORKERS=1
PLATFORM_QUEUE_POLL_SECONDS=1.0
PLATFORM_QUEUE_DEFAULT_PRIORITY=5
PLATFORM_QUEUE_MAX_ATTEMPTS=2
# Intermediate artifact retention before cleanup
PLATFORM_ARTIFACT_RETENTION_DAYS=7
